# ==============================================================================
# DineScan / Red Chilly — Production Environment Variables
# Copy this file to .env.local for local development or paste into Vercel Settings
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Cloud Configuration (Required)
# Found in: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. JWT Session Security (Required)
# 32+ character random secret used to sign HMAC-SHA256 guest session cookies
# Generate with: openssl rand -base64 32
# ------------------------------------------------------------------------------
JWT_SECRET=dinescan_secure_jwt_secret_red_chilly_2026_super_secret_key_982347

# Optional: For zero-downtime key rotation
# JWT_SECRET_PREVIOUS=previous_secret_key_here

# ------------------------------------------------------------------------------
# 3. Upstash Redis Edge Rate Limiter (Required in Production)
# Found in: Upstash Console -> Redis Database -> REST API
# Enforces fail-closed sliding-window rate limit (5 attempts / 15 mins) on PINs
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-redis-name-region.upstash.io
UPSTASH_REDIS_REST_TOKEN=AX_your_upstash_rest_token_here

# ------------------------------------------------------------------------------
# 4. Reception Staff Admin Passcode (Required)
# Used to authenticate staff at /admin console
# ------------------------------------------------------------------------------
STAFF_ADMIN_SECRET=redchilly2026
